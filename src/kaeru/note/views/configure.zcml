<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="kaeru.note">

  -*- extra stuff goes here -*-

  <browser:page
    name="note-view"
    for="Products.CMFCore.interfaces.IFolderish"
    class=".note_view.NoteView"
    template="note_view.pt"
    permission="zope2.View"
    />

  <!-- Note-specific master template: renders title, description,
       belowcontenttitle and abovecontenttitle (lead image, social
       tags) in that order. -->
  <browser:page
    name="main_template"
    for="kaeru.note.content.note.INote"
    template="note_main_template.pt"
    permission="zope.Public"
    />

  <browser:viewlet
    name="kaeru.note.leadimage"
    for="kaeru.note.content.note.INote"
    manager="plone.app.layout.viewlets.interfaces.IAboveContentTitle"
    class=".leadimage.NoteLeadImageViewlet"
    template="leadimage.pt"
    permission="zope2.View"
    />


</configure>
